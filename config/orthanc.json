{
  /**
   * Orthanc Configuration for Cura AI Health
   * Full documentation: https://book.orthanc-server.com/
   */
  
  "HttpPort": 8042,
  "DicomPort": 4242,
  "HttpServerEnabled": true,
  "DicomServerEnabled": true,
  "RemoteAccessAllowed": true,

  // Storage directory for DICOM files
  "StorageDirectory": "/var/lib/orthanc/db",

  // Authentication
  "AuthenticationEnabled": false,

  // Logging
  "LogLevel": 2,  // 0=ERROR, 1=WARNING, 2=INFO, 3=DEBUG

  // DICOM modalities
  "DicomModalities": {},

  // Peer Orthanc instances
  "OrthancPeers": {},

  // Enable CORS for web app
  "CorsOrigins": ["*"],

  // Enable REST API
  "RestApi": {
    "Enabled": true
  },

  // Storage compression
  "StorageCompression": true,

  // Job scheduling
  "JobsHistorySize": 10,

  // DICOM conformance
  "DicomConformance": {
    "AcceptPartialTransfers": true,
    "AllowFindWorklist": true
  },

  // Web application settings
  "WebUI": {
    "Enabled": true,
    "PublicUrl": "http://localhost:8042"
  }
}
