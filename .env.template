# Environment Variables for Cura AI Health Stack
# Copy this to .env and update values for your environment

# Orthanc Configuration
ORTHANC_PASSWORD=orthanc123

# Database Configuration
DB_USER=hapi_user
DB_PASSWORD=hapi_pass123
DB_ROOT_PASSWORD=root_pass123

# searXNG Configuration
SEARXNG_BASE_URL=http://localhost:8888

# Flask OCR Service
FLASK_ENV=production
OCR_WORKERS=4

# SSL/TLS (for production)
SSL_CERT_PATH=/etc/nginx/ssl/certs/server.crt
SSL_KEY_PATH=/etc/nginx/ssl/private/server.key
